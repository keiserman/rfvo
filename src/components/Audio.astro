---
interface Props {
  title: string;
  src: string;
}

const { title, src } = Astro.props;
---

<div class="p-4 border border-zinc-800 bg-zinc-900 rounded-lg">
  <figure>
    <figcaption class="text-lg pb-2">{title}</figcaption>
    <audio class="js-player w-full" controls src={src}></audio>
  </figure>
</div>
<script>
  import Plyr from "plyr";
  import "plyr/dist/plyr.css";

  document.querySelectorAll(".js-player").forEach((el) => new Plyr(el));
</script>
